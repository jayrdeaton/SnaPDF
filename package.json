{
  "name": "snapdf",
  "version": "1.0.1",
  "description": "Save ChatGPT conversations and JavaScript-rendered pages to searchable PDF or plain text",
  "keywords": [
    "cli",
    "pdf",
    "chatgpt",
    "chatgpt-to-pdf",
    "html-to-pdf",
    "webpage-to-pdf",
    "puppeteer",
    "headless",
    "scraper",
    "virtual-scroll",
    "chrome"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jayrdeaton/snapdf.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "bin": {
    "snapdf": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run lint && npm test",
    "watch": "tsup --watch"
  },
  "dependencies": {
    "cosmetic": "^1.4.0",
    "ora": "^9.4.0",
    "puppeteer": "^25.0.0",
    "termkit": "^2.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^1.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
